{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "open-problems-ai-eval",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-27",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "../../dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opae-db",
      "database_id": "f6559ccf-250c-4036-8f4b-61c36f6d32f6",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "TURNSTILE_HOSTNAMES": ""
  }
}
